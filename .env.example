# Database Configuration
MSSQL_DATABASE=dbname
MSSQL_USER=dbuser
MSSQL_PASSWORD=your_secure_password_here
MSSQL_ROOT_PASSWORD=your_secure_root_password_here

# PHPMyAdmin Configuration
PMA_HOST=db
PMA_USER=root
PMA_PASSWORD=your_secure_root_password_here

# Ports Configuration (for development only)
APACHE_PORT=80
MSSQL_PORT=1433
PHPMYADMIN_PORT=8080

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=30
PHP_UPLOAD_MAX_FILESIZE=20M
PHP_POST_MAX_SIZE=20M
